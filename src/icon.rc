// Controllin Injector resources
#include <winres.h>

// Named icon: Explorer uses it for the .exe, wxIconBundle loads it for the window/taskbar.
appicon ICON "icon\\icon.ico"

// Named resource: Explorer uses it for the .exe, wxIconBundle loads it for the window/taskbar.
appicon ICON "icon\\icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Controllin Injector"
            VALUE "ProductName", "Controllin Injector"
            VALUE "InternalName", "ControllinInjector"
            VALUE "OriginalFilename", "Controllin Injector.exe"
            VALUE "FileVersion", "2.0.0"
            VALUE "ProductVersion", "2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
